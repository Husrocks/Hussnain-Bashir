---
import BaseLayout from '@layouts/BaseLayout.astro';
import SEO from '@components/SEO.astro';
import PersonSchema from '@components/PersonSchema.astro';
import HeroGrain from '@components/HeroGrain.astro';
import ProjectCard from '@components/ProjectCard.astro';
import CodeEditorSkills from '@components/CodeEditorSkills.astro';
import MarqueeDivider from '@components/MarqueeDivider.astro';
import ExperienceTimeline from '@components/ExperienceTimeline.astro';
import EducationLeadership from '@components/EducationLeadership.astro';
import ScrambleHeading from '@components/ScrambleHeading.astro';
import MobileProfileCard from '@components/MobileProfileCard.astro';
import { getCollection } from 'astro:content';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// Fetch all projects and sort by featured first, then year descending
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => {
  const aHasLive = !!a.data.liveUrl;
  const bHasLive = !!b.data.liveUrl;
  if (aHasLive && !bHasLive) return -1;
  if (!aHasLive && bHasLive) return 1;

  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.year - a.data.year;
});

---
<BaseLayout
  title="Hussnain Bashir — AI Full-Stack Developer"
  description="Portfolio of Hussnain Bashir — AI/ML and Full-Stack Developer specializing in building end-to-end intelligent systems."
  site={Astro.site}
>
  <Fragment slot="head">
    <SEO 
      title="Hussnain Bashir — AI Full-Stack Developer"
      description="Portfolio of Hussnain Bashir. AI/ML and Full-Stack Developer specializing in building end-to-end intelligent systems, from fine-tuning LLMs to developing Web3 apps."
      canonicalUrl={canonicalUrl}
      type="website"
      ogImage="https://hussnain-bashir.vercel.app/og-image.jpg"
    />
    <PersonSchema 
      name="Hussnain Bashir"
      jobTitle="AI Full-Stack Developer"
      url={canonicalUrl}
    />
    <!-- WebSite schema for sitelinks search box eligibility -->
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "url": "https://hussnain-bashir.vercel.app/",
      "name": "Hussnain Bashir — Portfolio"
    })}</script>
  </Fragment>

  <!-- Mobile-only Profile Card (hidden on desktop) -->
  <MobileProfileCard />

  <!-- Desktop Layout (Hidden on Mobile) -->
  <div class="desktop-layout">
    <!-- Hero Section (hidden on mobile) -->
    <section class="hero">
      <div class="hero-content">
        
        <!-- Left Column: Typography -->
        <div class="hero-text-column">
          <h1 class="hero-title">
            <span>HUSSNAIN</span>
            <span>BASHIR</span>
          </h1>
          <p class="hero-subtitle">
            AI/ML & FULL-STACK DEVELOPER
          </p>
          <p class="hero-description">
            I craft digital experiences that are robust, highly performant, and built with purpose from advanced AI pipelines to scalable full-stack systems.
          </p>
          <div class="hero-accent-line"></div>
        </div>

        <!-- Right Column: Massive Hero Portrait -->
        <div class="hero-graphic-column">
          <div class="portrait-glow"></div>
          <img 
            src="/images/PROFILE.webp" 
            alt="Hussnain Bashir" 
            class="portrait-image" 
            width="700"
            height="850"
            loading="eager"
            decoding="async"
          />
        </div>
        
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section">
      <div class="about-inner">
        <div class="about-header">
          <ScrambleHeading text="ABOUT ME" tag="h2" class="section-title" />
        </div>
        <p>
          Hi, I'm <strong>Hussnain Bashir</strong>, an AI/ML and Full-Stack Developer dedicated to architecting and building scalable, next-generation intelligent systems.
        </p>

        <div class="about-stats">
          <div class="stat-item">
            <div class="stat-number-wrapper">
              <span class="stat-number">2+</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="stat-icon"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <span class="stat-label">Years of<br>Experience</span>
          </div>
          <div class="stat-item">
            <div class="stat-number-wrapper">
              <span class="stat-number">10+</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="stat-icon"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <span class="stat-label">Projects<br>Built</span>
          </div>
        </div>

        <div class="about-action">
          <a href="/about" class="about-link" data-cursor="hover">
            <span class="link-text">Get to know me better</span>
            <span class="link-arrow">&rarr;</span>
          </a>
        </div>

      </div>
    </section>

    <!-- Projects Section -->
    <section id="work" class="projects-section">
      <div class="projects-header">
        <ScrambleHeading text="PROJECTS" tag="h2" class="section-title" />
      </div>
      <div class="project-stack">
        {sortedProjects.length > 0 ? (
          sortedProjects.slice(0, 4).map((project, index) => (
            <ProjectCard project={project} index={index} priority={index === 0} />
          ))
        ) : (
          <p>No projects found. Add markdown files to src/content/projects/!</p>
        )}
      </div>
    </section>

    <!-- Animated Marquee Divider -->
    <MarqueeDivider />

    <!-- Skills Editor Section -->
    <CodeEditorSkills />

    <!-- Experience Section -->
    <ExperienceTimeline />

    <!-- Education & Leadership Section -->
    <EducationLeadership />
  </div>
</BaseLayout>

<style is:global>
  @media (max-width: 768px) {
    .desktop-layout {
      display: none !important;
    }
  }
</style>

<style>
  /* ── Hero Section ── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding-inline: clamp(1rem, 4vw, 3rem);
    padding-block-start: clamp(5rem, 10vh, 7rem);
    padding-block-end: 0;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-4);
    align-items: flex-end;
  }

  /* Typography Column */
  .hero-text-column {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: clamp(1.5rem, 5vh, 4rem);
    padding-bottom: clamp(1rem, 3.5vh, 2.5rem);
    z-index: 3;
  }

  @media (max-width: 960px) {
    .hero {
      align-items: center;
      padding-block-end: var(--space-6);
      min-height: auto;
      padding-top: clamp(6rem, 12vh, 8rem);
    }

    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-4);
      align-items: center;
    }

    .hero-text-column {
      align-items: center;
      padding-bottom: 0;
      padding-top: 0;
    }
  }

  .hero-title {
    font-size: clamp(2.3rem, 11vw, 8.2rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    font-weight: 900;
    margin-block-end: var(--space-4);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .hero-title span {
    display: block;
  }

  .hero-subtitle {
    font-size: clamp(0.85rem, 2.5vw, var(--text-base));
    color: var(--color-accent-2);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-block-end: var(--space-4);
  }

  .hero-description {
    font-size: clamp(1rem, 2.2vw, var(--text-lg));
    color: var(--color-text-muted);
    max-width: 520px;
    margin-block-end: var(--space-5);
    line-height: 1.6;
  }

  .hero-accent-line {
    width: 80px;
    height: 4px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  /* Right Graphic Column: Massive Portrait */
  .hero-graphic-column {
    position: relative;
    width: 100%;
    height: clamp(560px, 82vh, 850px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 0;
    overflow: visible;
  }

  .portrait-glow {
    position: absolute;
    width: clamp(280px, 40vw, 550px);
    height: clamp(280px, 40vw, 550px);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -45%);
    background: radial-gradient(circle, rgba(0, 255, 204, 0.25) 0%, rgba(138, 43, 226, 0.28) 45%, transparent 70%);
    filter: blur(60px);
    border-radius: 50%;
    z-index: 1;
    pointer-events: none;
  }

  .portrait-image {
    position: relative;
    width: auto;
    height: 100%;
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    object-position: center bottom;
    transform: translateY(20px) scale(1.18);
    transform-origin: center bottom;
    z-index: 2;
    filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 50px rgba(0, 255, 204, 0.2));
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), filter 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .portrait-image:hover {
    transform: translateY(20px) scale(1.22);
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 1)) drop-shadow(0 0 70px rgba(0, 255, 204, 0.35));
  }

  @media (max-width: 960px) {
    .hero-graphic-column {
      height: clamp(340px, 50vh, 460px);
      margin-top: var(--space-2);
    }
    .portrait-image {
      transform: translateY(0) scale(1.02);
      max-width: 90%;
    }
    .portrait-image:hover {
      transform: translateY(0) scale(1.04);
    }
  }

  /* ── About Section ── */
  .about-section {
    padding-inline: clamp(1rem, 4vw, var(--space-4));
    padding-block-start: clamp(4rem, 8vh, 6rem);
    padding-block-end: clamp(4rem, 12vh, 8rem); /* Increased for breathing room */
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .about-header {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(2rem, 5vh, 4rem);
  }
  .about-section :global(.section-title),
  .about-section :global(h2) {
    font-size: clamp(2.3rem, 9vw, 8.2rem) !important;
    line-height: 0.92 !important;
    letter-spacing: -0.035em !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    color: var(--color-text) !important;
    margin: 0 !important;
    display: inline-block;
  }
  .about-section p {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .about-section strong {
    color: var(--color-accent);
  }

  .about-stats {
    display: flex;
    justify-content: center;
    gap: clamp(3rem, 8vw, 6rem);
    margin-top: 3rem;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .stat-number-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stat-icon {
    color: var(--color-accent);
    opacity: 0.9;
    margin-bottom: 0;
  }
  .stat-number {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1.4;
  }

  .about-action {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
  }
  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 2rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }
  .about-link:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .link-arrow {
    color: var(--color-accent);
    transition: transform 0.3s ease;
  }
  .about-link:hover .link-arrow {
    transform: translateX(4px);
  }

  /* ── Projects Section ── */
  .projects-section {
    position: relative;
    padding-inline: clamp(1rem, 4vw, var(--space-4));
    padding-block-start: clamp(5rem, 12vh, 13rem);
    padding-block-end: clamp(4rem, 8vh, 7rem);
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    /* Hide the desktop hero and about on mobile — MobileProfileCard takes over */
    .hero,
    .about-section {
      display: none;
    }

    .projects-section {
      padding-block-start: 3rem;
      padding-block-end: 4rem;
    }
  }

  .projects-header {
    text-align: center;
    margin-block-end: clamp(2rem, 5vh, 4rem);
  }

  .projects-header :global(.section-title),
  .projects-header :global(h2),
  .projects-section :global(.section-title) {
    font-size: clamp(2.3rem, 9vw, 8.2rem) !important;
    line-height: 0.92 !important;
    letter-spacing: -0.035em !important;
    font-weight: 900 !important;
    text-transform: uppercase !important;
    color: var(--color-text) !important;
    margin: 0 !important;
    display: inline-block;
  }

  .project-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 620px;
    margin: 0 auto;
    padding-top: var(--space-2);
    padding-bottom: var(--space-6);
    width: 100%;
  }
</style>
