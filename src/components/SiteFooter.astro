---
/**
 * SiteFooter — bottom-of-page massive CTA & footer.
 */
---
<footer class="site-footer" id="contact">
  <!-- Massive CTA Section -->
  <div class="cta-container">
    <div class="cta-content">
      <h2 class="cta-title">
        <span class="cta-line line-1">
          <span class="anim-word word-lets" data-direction="left">LET'S</span>
          <span class="anim-word word-build" data-direction="top">BUILD</span>
        </span>
        <span class="cta-line line-2">
          <span class="anim-word text-gradient word-something" data-direction="bottom">SOMETHING</span>
        </span>
        <span class="cta-line line-3">
          <span class="anim-word word-extraordinary" data-direction="right">EXTRAORDINARY</span>
        </span>
      </h2>
      <p class="cta-subtitle">Ready to turn your ambitious ideas into reality? Let's connect and engineer the future.</p>
      
      <div class="cta-action">
        <a href="mailto:hussnain.bashir.go@gmail.com" class="cta-button glass-panel" data-cursor="hover">
          <span class="button-text">Start a Conversation</span>
          <span class="button-arrow">&rarr;</span>
          <div class="button-glow"></div>
        </a>
      </div>
    </div>
  </div>

  <!-- Meta Footer Section -->
  <div class="meta-footer">
    <div class="meta-inner">
      <div class="footer-brand">
        <span class="brand-name">Hussnain Bashir</span>
        <span class="brand-desc">AI/ML & Full-Stack Developer</span>
      </div>
      
      <div class="footer-links">
        <a href="https://github.com/Husrocks" target="_blank" rel="noopener noreferrer" data-cursor="hover">GitHub</a>
        <a href="https://www.linkedin.com/in/hussnain-bashir" target="_blank" rel="noopener noreferrer" data-cursor="hover">LinkedIn</a>
        <a href="https://x.com/RocksHus" target="_blank" rel="noopener noreferrer" data-cursor="hover">X (Twitter)</a>
        <a href="https://www.instagram.com/imhussnain_/" target="_blank" rel="noopener noreferrer" data-cursor="hover">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=100073461650652" target="_blank" rel="noopener noreferrer" data-cursor="hover">Facebook</a>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Hussnain Bashir. Crafted with care in Lahore, Pakistan.</p>
      <div class="back-to-top">
        <a href="#top" data-cursor="hover">Back to top &uarr;</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block-start: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--glass-border);
    overflow: hidden;
  }

  /* ── CTA Section ── */
  .cta-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--space-4);
    text-align: center;
    margin-bottom: clamp(4rem, 10vw, 6rem);
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .cta-title {
    font-size: clamp(3.5rem, 9vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    font-weight: 900;
    margin: 0;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .cta-line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.3em;
    flex-wrap: wrap;
  }

  .anim-word {
    display: inline-block;
    opacity: 0;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  /* Different entrance directions */
  .anim-word.word-lets {
    transform: translateX(-140px) rotate(-10deg);
  }

  .anim-word.word-build {
    transform: translateY(-120px) rotate(8deg);
  }

  .anim-word.word-something {
    transform: translateY(120px) scale(0.65) rotate(-4deg);
  }

  .anim-word.word-extraordinary {
    transform: translateX(160px) rotate(8deg);
  }

  /* When revealed by scroll observer */
  .cta-container.is-visible .anim-word {
    opacity: 1;
    transform: translate(0, 0) scale(1) rotate(0deg);
  }

  .cta-container.is-visible .word-lets {
    transition-delay: 0.1s;
  }

  .cta-container.is-visible .word-build {
    transition-delay: 0.28s;
  }

  .cta-container.is-visible .word-something {
    transition-delay: 0.45s;
  }

  .cta-container.is-visible .word-extraordinary {
    transition-delay: 0.62s;
  }

  /* Interactive hover physics */
  .anim-word:hover {
    transform: translateY(-10px) scale(1.05) !important;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    cursor: default;
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cta-subtitle {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .cta-action {
    margin-top: var(--space-4);
  }

  .cta-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-full);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cta-button::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    padding: 2px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    z-index: 1;
  }

  .button-text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-text);
    z-index: 2;
  }

  .button-arrow {
    font-size: var(--text-xl);
    color: var(--color-accent-2);
    z-index: 2;
    transition: transform 0.3s ease;
  }

  .button-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 150%;
    background: radial-gradient(circle, rgba(0,255,204,0.15) 0%, transparent 60%);
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
    pointer-events: none;
  }

  .cta-button:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 255, 204, 0.15);
  }

  .cta-button:hover .button-arrow {
    transform: translateX(8px);
  }

  .cta-button:hover .button-glow {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* ── Meta Footer Section ── */
  .meta-footer {
    padding-block: var(--space-6);
    padding-inline: var(--space-4);
    background: rgba(10, 10, 12, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--glass-border);
  }

  .meta-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .brand-name {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .brand-desc {
    font-size: var(--text-sm);
    color: var(--color-accent-2);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-links {
    display: flex;
    gap: var(--space-6);
    align-items: center;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-bottom p {
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    margin: 0;
  }

  .back-to-top a {
    color: var(--color-text-faint);
    text-decoration: none;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
  }

  .back-to-top a:hover {
    color: var(--color-accent);
  }
</style>

<script>
  function setupCtaAnimation() {
    const ctaContainer = document.querySelector('.cta-container');
    if (!ctaContainer) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          ctaContainer.classList.add('is-visible');
        }
      });
    }, { threshold: 0.12 });

    observer.observe(ctaContainer);
  }

  // Run on initial load and Astro page transitions
  setupCtaAnimation();
  document.addEventListener('astro:page-load', setupCtaAnimation);
</script>
