---
/**
 * SiteHeader — top-level page header.
 *
 * Intentionally unstyled at this stage — structurally correct,
 * semantically meaningful. Navigation links will be added in a
 * later phase once the design is established.
 */
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" data-cursor="hover" aria-label="Hussnain Bashir Home">HB</a>
    
    <nav aria-label="Main navigation" class="main-nav">
      <ul class="nav-links">
        <li><a href="/" data-cursor="hover"><span data-text="Home">Home</span></a></li>
        <li><a href="/projects" data-cursor="hover"><span data-text="Projects">Projects</span></a></li>
        <li><a href="/about" data-cursor="hover"><span data-text="About">About</span></a></li>
        <li><a href="mailto:hussnain.bashir.go@gmail.com" data-cursor="hover"><span data-text="Email">Email</span></a></li>
        <li><a href="https://www.linkedin.com/in/hussnain-bashir" target="_blank" rel="noopener noreferrer" data-cursor="hover"><span data-text="LinkedIn">LinkedIn</span></a></li>
        <li><a href="https://github.com/Husrocks" target="_blank" rel="noopener noreferrer" data-cursor="hover"><span data-text="GitHub">GitHub</span></a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding-inline: clamp(1rem, 3vw, 3rem);
    padding-block-start: clamp(1rem, 2vh, 2rem);
    pointer-events: none;
  }

  .header-inner {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: auto;
    gap: var(--space-2);
  }

  .logo {
    font-size: clamp(1.25rem, 4vw, var(--text-2xl));
    font-weight: 900;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.05em;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: clamp(0.75rem, 1.8vw, var(--space-4));
    list-style: none;
    margin: 0;
    padding: 0;
    height: 40px;
    align-items: center;
    background: var(--glass-bg);
    padding-inline: clamp(0.75rem, 2vw, var(--space-4));
    border-radius: var(--radius-full);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  /* Upward Rolling Text Effect */
  .nav-links li a {
    position: relative;
    display: inline-block;
    height: 20px;
    line-height: 20px;
    overflow: hidden;
    color: var(--color-text-muted) !important;
    text-decoration: none !important;
    font-size: clamp(0.78rem, 1.5vw, var(--text-sm));
    font-weight: var(--weight-medium);
    vertical-align: middle;
    white-space: nowrap;
  }

  .nav-links li a span {
    position: relative;
    display: inline-block;
    height: 20px;
    line-height: 20px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    color: var(--color-text-muted) !important;
    text-decoration: none !important;
  }

  .nav-links li a span::after {
    content: attr(data-text);
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 20px;
    line-height: 20px;
    color: var(--color-accent-2) !important;
    font-weight: var(--weight-semibold);
    text-decoration: none !important;
  }

  .nav-links li a:hover span {
    transform: translateY(-20px);
  }

  @media (max-width: 640px) {
    /* Hide external social links in mobile top bar to prevent clutter, keeping primary routes */
    .nav-links li:nth-child(4),
    .nav-links li:nth-child(5),
    .nav-links li:nth-child(6) {
      display: none;
    }
    
    .nav-links {
      gap: 1rem;
      padding-inline: 1rem;
    }
  }
</style>
