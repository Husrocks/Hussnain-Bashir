---
// MobileProfileCard.astro — visible ONLY on mobile (< 768px)
// Redesigned to match Bento Grid profile layout
---

<div class="mobile-page">
  <div class="dashboard-container">
    
    <!-- ══ Main Profile Card ══ -->
    <div class="main-card">
      <div class="avatar-squircle">
        <img
          src="/images/hussnain.webp"
          alt="Hussnain Bashir"
          class="avatar-img"
          width="160"
          height="160"
          loading="eager"
        />
      </div>
      
      <!-- aria-hidden: desktop layout has the canonical H1; this mobile H1
           is hidden on desktop via CSS, but both exist in the DOM for crawlers.
           Using aria-hidden prevents duplicate H1 confusion for search engines
           while keeping a visible heading for mobile users. -->
      <h1 class="p-name" aria-hidden="true">Hussnain Bashir</h1>
      <!-- Accessible name for screen readers on mobile -->
      <p class="p-name-sr-only" aria-label="Hussnain Bashir" role="heading" aria-level="1"></p>
      <p class="p-handle">@hussnain.bashir</p>
      
      <div class="bio-list">
        <div class="bio-item">
          <span class="emoji">🚀</span>
          <span class="text">AI/ML & Full-Stack Developer</span>
        </div>
        <div class="bio-item">
          <span class="emoji">📍</span>
          <span class="text">Building Intelligent Systems</span>
        </div>
        <div class="bio-item">
          <span class="emoji">👨‍💻</span>
          <span class="text">Dev by Day | AI Wizard by Night.</span>
        </div>
      </div>
      
      <div class="card-footer">
        <div class="footer-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Lahore, Pakistan
        </div>
        <div class="footer-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          2+ Years Exp
        </div>
      </div>
    </div>

    <!-- ══ Bento Grid ══ -->
    <div class="bento-grid">
      
      <!-- Row 1: Email & LinkedIn -->
      <a href="mailto:hussnain.bashir.go@gmail.com" class="bento-card bento-email">
        <div class="bento-top">
          <svg class="main-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          <svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </div>
        <div class="bento-bottom">
          <span class="b-title">Email</span>
          <span class="b-sub">hussnain.bashir.go@gmail.com</span>
        </div>
      </a>
      
      <a href="https://www.linkedin.com/in/hussnain-bashir" target="_blank" rel="noopener noreferrer" class="bento-card bento-linkedin">
        <div class="bento-top">
          <svg class="main-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </div>
        <div class="bento-bottom">
          <span class="b-title">LinkedIn</span>
          <span class="b-sub">@hussnain-bashir</span>
        </div>
      </a>

      <!-- Row 2: GitHub -->
      <a href="https://github.com/Husrocks" target="_blank" rel="noopener noreferrer" class="bento-card bento-github full-width">
        <div class="bento-top">
          <div class="github-left">
            <svg class="main-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span class="follow-btn">Follow</span>
          </div>
          <svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </div>
        <div class="bento-bottom">
          <span class="b-title">GitHub</span>
          <span class="b-sub">@Husrocks</span>
        </div>
      </a>

      <!-- Row 3: X & Instagram -->
      <a href="https://x.com/RocksHus" target="_blank" rel="noopener noreferrer" class="bento-card bento-twitter">
        <div class="bento-top">
          <svg class="main-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </div>
        <div class="bento-bottom">
          <span class="b-title">X (Twitter)</span>
          <span class="b-sub">@RocksHus</span>
        </div>
      </a>
      
      <a href="https://www.instagram.com/imhussnain_/" target="_blank" rel="noopener noreferrer" class="bento-card bento-instagram">
        <div class="bento-top">
          <svg class="main-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          <svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </div>
        <div class="bento-bottom">
          <span class="b-title">Instagram</span>
          <span class="b-sub">@imhussnain_</span>
        </div>
      </a>

    </div>
  </div>
</div>

<style>
  .mobile-page {
    display: none;
  }

  @media (max-width: 768px) {
    /* ── Full viewport fit — no scroll ── */
    .mobile-page {
      display: flex;
      flex-direction: column;
      height: 100svh;
      padding-bottom: 4.5rem; /* nav bar height */
      background: linear-gradient(160deg, #1A1325 0%, #080A10 100%);
      overflow: hidden;
      box-sizing: border-box;
    }

    .dashboard-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 0 0.65rem;
      overflow: hidden;
      padding-top: 2.8rem;
    }

    /* ── Main Profile Card ── */
    .main-card {
      background: #181C27;
      border-radius: 20px;
      margin-top: 2.4rem;
      padding: 2.4rem 1rem 0.6rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      box-shadow: 0 12px 30px rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.04);
      flex-shrink: 0;
    }

    /* Top overlapping avatar */
    .avatar-squircle {
      position: absolute;
      top: -2.4rem;
      left: 50%;
      transform: translateX(-50%);
      width: 72px;
      height: 72px;
      background: #F5BA3F;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(0,0,0,0.4);
      border: 2px solid rgba(255,255,255,0.06);
    }

    .avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Name & Handle */
    .p-name {
      font-size: 0.95rem;
      font-weight: 800;
      color: #fff;
      margin: 0 0 0.05rem 0;
      letter-spacing: -0.02em;
    }

    /* Screen-reader-only heading */
    .p-name-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .p-handle {
      font-size: 0.65rem;
      color: #A0A5B5;
      margin: 0 0 0.4rem 0;
      font-weight: 500;
    }

    /* Bio List */
    .bio-list {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      width: 100%;
      max-width: 280px;
      margin-bottom: 0.4rem;
    }

    .bio-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .bio-item .emoji {
      font-size: 0.75rem;
    }

    .bio-item .text {
      font-size: 0.65rem;
      color: #C0C4D1;
      font-weight: 500;
    }

    /* Card Footer */
    .card-footer {
      display: flex;
      justify-content: space-between;
      width: 100%;
      padding-top: 0.4rem;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    .footer-item {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.6rem;
      color: #80869B;
      font-weight: 500;
    }

    .footer-item svg {
      width: 10px;
      height: 10px;
    }

    /* ── Bento Grid — fills remaining space ── */
    .bento-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 0.7fr 1fr;
      gap: 0.5rem;
      flex: 1;
      min-height: 0; /* allow flex child to shrink */
    }

    .bento-card {
      background: #181C27;
      border-radius: 18px;
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.03);
      transition: transform 0.2s ease;
      -webkit-tap-highlight-color: transparent;
      overflow: hidden;
      min-height: 0;
    }

    .bento-card:active {
      transform: scale(0.96);
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .bento-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
    }

    .main-icon {
      width: 24px;
      height: 24px;
      color: #fff;
    }

    .ext-icon {
      width: 14px;
      height: 14px;
      color: rgba(255,255,255,0.4);
    }

    .github-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .follow-btn {
      background: #fff;
      color: #000;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      border-radius: 100px;
    }

    .bento-bottom {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }

    .b-title {
      font-size: 0.82rem;
      font-weight: 700;
      color: #fff;
    }

    .b-sub {
      font-size: 0.65rem;
      color: rgba(255,255,255,0.6);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Card Colors */
    .bento-email  { background: #1E2841; }
    .bento-linkedin { background: #0A66C2; }
    .bento-linkedin .b-sub,
    .bento-linkedin .ext-icon { color: rgba(255,255,255,0.8); }
    .bento-github { background: #111319; }
    .bento-twitter {
      background: #000;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .bento-instagram {
      background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    }
    .bento-instagram .b-sub,
    .bento-instagram .ext-icon { color: rgba(255,255,255,0.8); }
  }
</style>
