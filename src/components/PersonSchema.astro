---
/**
 * PersonSchema — JSON-LD structured data for the site owner.
 *
 * Inject via <slot name="head"> on the homepage only.
 * Replace all YOUR_* placeholders with real values before launch.
 *
 * Schema.org reference: https://schema.org/Person
 */
interface Props {
  /** Full name of the person */
  name: string;
  /** Professional title */
  jobTitle: string;
  /** URL for the person (e.g. site URL) */
  url: string;
}

const { name, jobTitle, url } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle,
  url,
  image: 'https://hussnain-bashir.vercel.app/og-image.jpg',
  sameAs: [
    'https://github.com/Husrocks',
    'https://www.linkedin.com/in/hussnain-bashir/',
    'https://x.com/RocksHus',
    'https://www.instagram.com/imhussnain_/',
  ],
  knowsAbout: [
    'Machine Learning',
    'Agentic AI',
    'Full-Stack Development',
    'Python',
    'React',
    'FastAPI',
    'TypeScript',
    'LLMs',
    'Computer Vision',
    'Docker',
    'Web3',
    'Solidity',
    'YOLOv8',
    'LangChain',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lahore',
    addressCountry: 'PK',
  },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
