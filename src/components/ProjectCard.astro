---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  priority?: boolean;
}

const { project, index = 0 } = Astro.props;
const { title, slug, summary, stack, year } = project.data;

// Alternating rotation angles for the stacked credit-card aesthetic
const rotations = [-5, 4, -4, 5];
const currentRotation = rotations[index % rotations.length];
const themeClass = `theme-${index % 4}`;
---

<a 
  href={`/projects/${slug}`} 
  class:list={["project-card", themeClass]} 
  style={`--rotation: ${currentRotation}deg; --stack-index: ${index};`}
  data-cursor="view" 
  data-cursor-label="View"
>
  <!-- Card Background Decorative Wave Lines -->
  <div class="card-bg-decoration" aria-hidden="true">
    <svg viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-20 80 Q 80 20 180 90 T 380 40 T 450 120" stroke="currentColor" stroke-width="2.5" opacity="0.25" />
      <circle cx="280" cy="40" r="6" fill="currentColor" opacity="0.3" />
    </svg>
  </div>

  <article class="card-inner">
    <!-- Card Top Bar (Chip / Overlapping Circles & Year) -->
    <div class="card-top">
      <div class="card-chip">
        <span class="chip-circle"></span>
        <span class="chip-circle overlap"></span>
      </div>
      <div class="card-meta">
        <span class="meta-label">YEAR</span>
        <span class="meta-val">{year || '2024'}</span>
      </div>
    </div>

    <!-- Main Headline & Description -->
    <div class="card-main">
      <h3 class="card-title">{title}</h3>
      <p class="card-summary">{summary}</p>
    </div>

    <!-- Bottom Stack Tags & Action -->
    <div class="card-bottom">
      <div class="stack-tags-wrapper">
        <span class="meta-label">TECH STACK</span>
        <ul class="stack-tags">
          {stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
      </div>
      <div class="card-action">
        <span>Explore</span> &rarr;
      </div>
    </div>
  </article>
</a>

<style>
  .project-card {
    display: block;
    text-decoration: none !important;
    width: 100%;
    max-width: 580px;
    border-radius: 26px;
    position: relative;
    overflow: hidden;
    transform: rotate(var(--rotation));
    transform-origin: center center;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), 
                box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                z-index 0.05s ease;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.45);
    margin-top: calc(var(--stack-index) * -2.2rem);
    z-index: calc(var(--stack-index) + 2);
    cursor: pointer;
  }

  .project-card:first-child {
    margin-top: 0;
  }

  .project-card:hover {
    transform: rotate(0deg) scale(1.04) translateY(-12px);
    z-index: 50 !important;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.75);
  }

  .card-bg-decoration {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .card-bg-decoration svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Themes matching the reference image cards */

  /* Theme 0: Vibrant Golden Yellow (1st Card) */
  .theme-0 {
    background: #FFB800 !important;
    color: #111111 !important;
  }
  .theme-0 .card-title { color: #000000 !important; }
  .theme-0 .card-summary { color: #222222 !important; }
  .theme-0 .chip-circle { background: #000000; }
  .theme-0 .meta-label { color: rgba(0, 0, 0, 0.6) !important; }
  .theme-0 .meta-val { color: #000000 !important; }
  .theme-0 .stack-tags li { background: rgba(0, 0, 0, 0.08); border: 1px solid rgba(0, 0, 0, 0.15); color: #000000; }
  .theme-0 .card-action { color: #000000; }
  .theme-0 .card-bg-decoration { color: #ffffff; }

  /* Theme 1: Crisp Warm Off-White (2nd Card) */
  .theme-1 {
    background: #FAF7EE !important;
    color: #111111 !important;
  }
  .theme-1 .card-title { color: #000000 !important; }
  .theme-1 .card-summary { color: #333333 !important; }
  .theme-1 .chip-circle { background: #111111; }
  .theme-1 .meta-label { color: rgba(0, 0, 0, 0.55) !important; }
  .theme-1 .meta-val { color: #111111 !important; }
  .theme-1 .stack-tags li { background: rgba(0, 0, 0, 0.06); border: 1px solid rgba(0, 0, 0, 0.12); color: #111111; }
  .theme-1 .card-action { color: #111111; }
  .theme-1 .card-bg-decoration { color: #FF4081; }

  /* Theme 2: Electric Cobalt Blue (3rd Card) */
  .theme-2 {
    background: #1877F2 !important;
    color: #FFFFFF !important;
  }
  .theme-2 .card-title { color: #FFFFFF !important; }
  .theme-2 .card-summary { color: rgba(255, 255, 255, 0.92) !important; }
  .theme-2 .chip-circle { background: #FFFFFF; }
  .theme-2 .meta-label { color: rgba(255, 255, 255, 0.7) !important; }
  .theme-2 .meta-val { color: #FFFFFF !important; }
  .theme-2 .stack-tags li { background: rgba(255, 255, 255, 0.18); border: 1px solid rgba(255, 255, 255, 0.3); color: #FFFFFF; }
  .theme-2 .card-action { color: #FFFFFF; }
  .theme-2 .card-bg-decoration { color: #000000; }

  /* Theme 3: Deep Royal Purple / Indigo (4th Card) */
  .theme-3 {
    background: #7C3AED !important;
    color: #FFFFFF !important;
  }
  .theme-3 .card-title { color: #FFFFFF !important; }
  .theme-3 .card-summary { color: rgba(255, 255, 255, 0.9) !important; }
  .theme-3 .chip-circle { background: #FFFFFF; }
  .theme-3 .meta-label { color: rgba(255, 255, 255, 0.7) !important; }
  .theme-3 .meta-val { color: #FFFFFF !important; }
  .theme-3 .stack-tags li { background: rgba(255, 255, 255, 0.18); border: 1px solid rgba(255, 255, 255, 0.3); color: #FFFFFF; }
  .theme-3 .card-action { color: #FFFFFF; }
  .theme-3 .card-bg-decoration { color: #00FFFF; }

  /* Inner Card Layout */
  .card-inner {
    position: relative;
    z-index: 2;
    padding: 1.65rem 1.95rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 240px;
    gap: 0.8rem;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-chip {
    display: flex;
    align-items: center;
  }

  .chip-circle {
    width: 21px;
    height: 21px;
    border-radius: 50%;
    display: inline-block;
  }

  .chip-circle.overlap {
    margin-left: -9px;
    opacity: 0.55;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.1;
  }

  .meta-label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .meta-val {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.9rem;
  }

  .card-main {
    margin-block: 0.25rem;
  }

  .card-title {
    font-size: clamp(1.45rem, 2.8vw, 1.8rem);
    font-weight: 850;
    line-height: 1.18;
    margin: 0 0 0.45rem 0;
    letter-spacing: -0.025em;
  }

  .card-summary {
    font-size: 0.92rem;
    line-height: 1.48;
    margin: 0;
    font-weight: 500;
    max-width: 98%;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .stack-tags-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stack-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .stack-tags li {
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.65rem;
    border-radius: 16px;
  }

  .card-action {
    font-weight: 850;
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .project-card {
      max-width: 100%;
      margin-top: 0 !important;
      margin-bottom: 4rem; /* Spacing between cards before they stick */
      transform: none !important;
      border-radius: 20px;
      position: sticky;
      top: calc(100px + (var(--stack-index) * 16px));
      transition: all 0.3s ease;
    }

    .project-card:active {
      transform: scale(0.97) !important;
      box-shadow: 0 5px 15px rgba(0,0,0,0.3) !important;
    }

    .project-card:first-child {
      margin-top: 0 !important;
    }

    .card-inner {
      padding: 1.15rem 1.15rem;
      min-height: auto;
      gap: 0.75rem;
    }

    .card-title {
      font-size: 1.25rem;
      margin-bottom: 0.2rem;
    }
    
    .card-summary {
      font-size: 0.85rem;
      line-height: 1.35;
    }

    .card-bottom {
      flex-direction: row;
      align-items: flex-end;
      gap: 0.5rem;
    }
    
    .stack-tags li {
      font-size: 0.6rem;
      padding: 0.15rem 0.45rem;
      border-radius: 12px;
    }

    .card-action {
      align-self: flex-end;
      font-size: 0.75rem;
      margin-bottom: 0.2rem;
    }
  }
</style>
