---
/**
 * SEO — reusable head meta component.
 *
 * Renders all SEO-relevant tags for a page. Inject into pages via the
 * BaseLayout <slot name="head"> so every page controls its own meta.
 *
 * Usage:
 *   <slot name="head">
 *     <SEO
 *       title="Page Title"
 *       description="Page description."
 *       canonicalUrl="https://example.com/page"
 *       type="website"
 *       ogImage="https://example.com/og.png"
 *     />
 *   </slot>
 */
interface Props {
  /** Full page <title> value */
  title: string;
  /** Meta description — keep under 160 characters */
  description: string;
  /** Absolute canonical URL for this page */
  canonicalUrl: string;
  /** Open Graph type */
  type: 'website' | 'profile' | 'article';
  /** Absolute URL to the OG image (optional — tag omitted when absent) */
  ogImage?: string;
  /** OG image width in pixels (default 1200) */
  ogImageWidth?: number;
  /** OG image height in pixels (default 630) */
  ogImageHeight?: number;
}

const {
  title,
  description,
  canonicalUrl,
  type,
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;
---
<!-- Primary -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Hussnain Bashir" />
<meta name="robots" content="index, follow" />

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Hussnain Bashir" />
<meta property="og:locale" content="en_US" />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImage && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImage && <meta property="og:image:alt" content={title} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@RocksHus" />
<meta name="twitter:creator" content="@RocksHus" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={title} />}

<!-- Google Search Console Verification -->
<meta name="google-site-verification" content="56d73131ab933b31" />

